// Example ACL. Set -cap-name (or TSDNSPROXY_CAP_NAME) to example.com/cap/dns
// so these grants match. The program default is a different name.
{
  "tagOwners": {
    "tag:tsdnsproxy": ["autogroup:admin"]
  },
  "autoApprovers": {
    "services": {
      "svc:dns": ["tag:tsdnsproxy"]
    }
  },
  "grants": [
    {
      "src": ["autogroup:member"],
      "dst": ["svc:dns"],
      "ip": ["53"]
    },
    {
      "src": ["alice@example.com"],
      "dst": ["tag:tsdnsproxy"],
      "app": {
        "example.com/cap/dns": [
          {
            "example.internal": {
              "dns": ["10.0.0.53:53", "10.0.0.54:53"],
              "translateid": 1,
              "allowips": ["10.0.0.0/8"]
            },
            "app.example.ts.net": {
              "dns": ["direct://10.0.0.53:53"],
              "rewrite": "example.internal",
              "translateid": -1
            },
            "site.example": {
              "ipnames": {
                "siteid": 1,
                "a": "never",
                "allowips": ["10.0.0.0/8"]
              }
            }
          }
        ]
      }
    }
  ]
}
